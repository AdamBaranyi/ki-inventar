# Liefert die gebaute App aus. Läuft auf vps1 hinter dem Caddy von Tallyroom,
# der TLS, HSTS und das Zugriffsprotokoll übernimmt (14 Tage). Hier stehen die
# Kopfzeilen der App: GitHub Pages kann sie nicht setzen, darum der Umzug.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	# Dieselbe Richtlinie wie im Meta-Tag der index.html, dazu frame-ancestors,
	# das nur als Kopfzeile wirkt: Niemand darf die App in einen Rahmen laden.
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Dateien mit Inhalts-Hash im Namen ändern sich nie: ein Jahr im Cache.
	# Alles andere, vor allem index.html, fragt jedes Mal nach.
	@mitHash path_regexp ^/((chunk|main)-[A-Za-z0-9_-]{8}\.js|styles-[A-Za-z0-9_-]{8}\.css|media/[^/]+-[A-Za-z0-9_-]{8}\.woff2)$
	header @mitHash Cache-Control "public, max-age=31536000, immutable"
	@ohneHash not path_regexp ^/((chunk|main)-[A-Za-z0-9_-]{8}\.js|styles-[A-Za-z0-9_-]{8}\.css|media/[^/]+-[A-Za-z0-9_-]{8}\.woff2)$
	header @ohneHash Cache-Control "no-cache"

	# Die App routet selbst: Jeder unbekannte Pfad bekommt die index.html.
	try_files {path} /index.html
	file_server
}
