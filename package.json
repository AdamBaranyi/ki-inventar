{
  "name": "ki-inventar",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /ki-inventar/ && node scripts/nach-build.mjs",
    "test": "ng test --watch=false",
    "test:skripte": "vitest run --root scripts",
    "test:e2e": "playwright test",
    "pruefe": "node scripts/pruefe-quelltext.mjs",
    "sabotage": "node scripts/sabotage.mjs",
    "check": "bun run pruefe && bun run test && bun run test:skripte && bun run build && bun run test:e2e",
    "test:e2e:browsers": "playwright test --config playwright.browsers.config.ts"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "8.3.4",
    "zod": "4.6.6"
  }
}
